{
	"name": "webmultipliers/wp2-shopify-id",
	"description": "Connects WordPress Users to Shopify Customer Accounts using the Customer Account API (PKCE).",
	"type": "project",
	"require": {
		"php": ">=7.4",
		"defuse/php-encryption": "^2.3",
		"guzzlehttp/guzzle": "^7.0",
		"league/oauth2-client": "^2.6",
		"fabrikat/blockstudio": "^4.0.2"
	},
	"autoload": {
		"psr-4": {
			"WP2_Shopify\\": "src/"
		}
	},
	"scripts": {
		"build": [
			"composer install --no-dev --prefer-dist --optimize-autoloader --classmap-authoritative",
			"npm ci --omit=dev",
			"npx modclean --run --ignore node_modules/.bin",
			"npx vite build",
			"rm -rf node_modules"
		]
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"composer/installers": true,
			"ffraenz/private-composer-installer": true
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"repositories": [
		{
			"type": "package",
			"package": {
				"name": "fabrikat/blockstudio",
				"version": "4.0.2",
				"type": "vendor",
				"dist": {
					"type": "zip",
					"url": "https://blockstudio.dev/download?v={%VERSION}&k={%BLOCKSTUDIO_KEY}"
				},
				"require": {
					"ffraenz/private-composer-installer": "^5.0.1"
				}
			}
		}
	]
}